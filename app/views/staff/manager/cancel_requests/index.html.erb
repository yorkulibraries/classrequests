<% page_title t(:cancel_requests) %>

<div class='d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3'>
  <div>
    <h1 class='mb-1'>Cancellation requests</h1>
    <p class='text-muted mb-0'>Review pending requests and retain completed records as an audit history.</p>
  </div>
  <%= link_to staff_manager_teaching_requests_path, class: 'btn btn-outline-secondary' do %>
    <i class='fas fa-arrow-left me-1' aria-hidden='true'></i>
    <%= t(:return_to_manager_dashboard) %>
  <% end %>
</div>

<% if @cancel_requests.any? %>
  <div class='card bg-white border shadow-sm mb-4'>
    <div class='table-responsive'>
      <table class='table table-striped table-hover align-middle mb-0'>
        <thead class='table-light'>
          <tr>
            <th scope='col'>Requested by</th>
            <th scope='col'>Teaching request</th>
            <th scope='col'>Submitted</th>
            <th scope='col'>Reason</th>
            <th scope='col'>Workflow status</th>
            <th scope='col' class='text-end'>Action</th>
          </tr>
        </thead>
        <tbody>
          <% @cancel_requests.each do |cancel_request| %>
            <%= content_tag :tr, id: dom_id(cancel_request), class: dom_class(cancel_request) do %>
              <td>
                <span class='fw-semibold'><%= cancel_request.user.name %></span><br>
                <small class='text-muted'><%= cancel_request.user.email %></small>
              </td>
              <td><%= cancel_request.teaching_request.name %></td>
              <td class='text-nowrap'><%= l(cancel_request.created_at, format: :long) %></td>
              <td><%= simple_format(cancel_request.reason, {}, wrapper_tag: 'div') %></td>
              <td>
                <% if cancel_request.cancelled? %>
                  <span class='badge bg-secondary'>Cancelled</span>
                <% elsif cancel_request.deleted? %>
                  <span class='badge bg-danger'>Deleted</span>
                <% else %>
                  <span class='badge bg-warning text-dark'>Pending manager review</span>
                <% end %>
              </td>
              <td class='text-end text-nowrap'>
                <%= link_to staff_manager_teaching_request_path(cancel_request.teaching_request),
                            class: 'btn btn-sm btn-outline-secondary' do %>
                  <i class='fas fa-eye me-1' aria-hidden='true'></i>
                  Review request
                <% end %>
                <% unless cancel_request.processed? %>
                  <%= link_to staff_mark_cancelled_teaching_request_path(id: cancel_request.teaching_request_id),
                              method: :patch,
                              data: {confirm: 'Mark this request cancelled and notify the requestor and managers?'},
                              class: 'btn btn-sm btn-warning text-dark ms-1' do %>
                    <i class='fas fa-ban me-1' aria-hidden='true'></i>
                    Mark cancelled
                  <% end %>
                  <%= link_to staff_mark_deleted_teaching_request_path(id: cancel_request.teaching_request_id),
                              method: :patch,
                              data: {confirm: 'Mark this request deleted? Use Delete only for duplicate, test, or invalid records. No cancellation notification will be sent.'},
                              class: 'btn btn-sm btn-danger ms-1' do %>
                    <i class='fas fa-trash-alt me-1' aria-hidden='true'></i>
                    Delete
                  <% end %>
                <% end %>
              </td>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% else %>
  <div class='card bg-white border shadow-sm'>
    <div class='card-body py-4'>
      <h2 class='h4 mb-2'>No cancellation requests</h2>
      <p class='text-muted mb-0'>Submitted cancellation requests will appear here for manager review.</p>
    </div>
  </div>
<% end %>
