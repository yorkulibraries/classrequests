<% remote_form = local_assigns.fetch(:remote, false) %>
<% modal_form = local_assigns.fetch(:modal, false) %>

<%= simple_form_for(
      @teaching_request,
      url: staff_manager_portfolio_classification_path(id: @teaching_request.id),
      method: :patch,
      remote: remote_form,
      html: { id: 'portfolio_classification_form' }
    ) do |f| %>
  <%= f.error_notification %>
  <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

  <section aria-labelledby="portfolio-classification-request-heading">
    <h2 id="portfolio-classification-request-heading" class="h5 text-primary">
      <%= t('subject_portfolios.assignment.request_information') %>
    </h2>
    <dl class="row small mb-4">
      <dt class="col-sm-3"><%= t('subject_portfolios.assignment.fields.requestor') %></dt>
      <dd class="col-sm-9"><%= @teaching_request.first_name %> <%= @teaching_request.last_name %></dd>

      <dt class="col-sm-3"><%= t('subject_portfolios.assignment.fields.course') %></dt>
      <dd class="col-sm-9">
        <%= @teaching_request.faculty_abbrev %>/<%= @teaching_request.subject_abbrev %>
        <%= @teaching_request.course_number %> <%= @teaching_request.academic_year %>
      </dd>

      <dt class="col-sm-3"><%= t(:status) %></dt>
      <dd class="col-sm-9"><%= @teaching_request.status.text %></dd>

      <dt class="col-sm-3"><%= t(:assigned_instructors) %></dt>
      <dd class="col-sm-9 mb-0">
        <% instructors = [
             @teaching_request.lead_instructor,
             @teaching_request.second_instructor,
             @teaching_request.third_instructor
           ].compact.uniq %>
        <%= instructors.any? ? instructors.map(&:full_name).join(', ') : t('subject_portfolios.classification.no_instructors') %>
      </dd>
    </dl>
  </section>

  <section aria-labelledby="portfolio-classification-heading">
    <h2 id="portfolio-classification-heading" class="h5 text-primary">
      <%= t('subject_portfolios.classification.heading') %>
    </h2>
    <p class="small text-muted"><%= t('subject_portfolios.classification.help') %></p>
    <%= f.input :subject_portfolio_id,
                collection: @subject_portfolios,
                label: t('subject_portfolios.assignment.fields.subject_portfolio'),
                label_method: :name,
                value_method: :id,
                include_blank: t('subject_portfolios.classification.no_portfolio'),
                required: false,
                input_html: { class: 'form-select' } %>
  </section>

  <div class="d-flex gap-2 border-top pt-3 mt-4">
    <%= f.button :submit,
                 t('subject_portfolios.classification.actions.save'),
                 class: 'btn btn-success' %>
    <% if modal_form %>
      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
        <%= t('subject_portfolios.assignment.actions.cancel') %>
      </button>
    <% else %>
      <%= link_to t('subject_portfolios.assignment.actions.cancel'),
                  staff_manager_teaching_requests_path,
                  class: 'btn btn-secondary' %>
    <% end %>
  </div>
<% end %>
