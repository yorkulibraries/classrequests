

<div class="p-4 p-lg-5 mb-4 bg-white rounded-3">

  <header class="container-xl px-0 mb-3">
    <h1 class="display-5 mb-3"><%= t(:library_class_request_form) %></h1>
    <hr class="primary mb-0"/>
  </header>

  <%# New stacked homepage content. Keep the previous two-column layout below while this is reviewed. %>
  <div class="container-xl px-0 mt-4">
    <section class="row mx-0 mb-4 bg-white border border-2 rounded-1">
      <div class="col-12 p-0">
        <div class="p-3 border-start border-5 border-primary">
            <h2 class="h3 mb-2">
              <i class="fas fa-book-reader text-primary me-2" aria-hidden="true"></i>
              <%= link_to "Think, Research, Create: Introduction to Library Research", "https://www.library.yorku.ca/web/ask-services/facultyinstructor-support/think-research-create-introduction-to-library-research/" %>
              <span class="fw-normal">("Core")</span>
            </h2>
            <p class="col-xl-10 px-0 mb-2">Four classes, 90 minutes each, interactive and practical.</p>
            <ul class="col-xl-10 mb-3 ps-4">
              <li class="mb-1">Students can receive a certificate of participation after they complete a quiz following each library class.</li>
              <li>Learning outcomes, registration, schedules, and more information are available <%= link_to "here", "https://www.library.yorku.ca/web/ask-services/facultyinstructor-support/think-research-create-introduction-to-library-research/" %>.</li>
            </ul>
            <div class="d-flex flex-column flex-sm-row align-items-sm-center gap-3 mt-3">
              <%= link_to new_user_intro_library_research_path, class: "btn btn-primary fw-bold text-wrap" do %>
                <i class="fas fa-calendar-plus me-1" aria-hidden="true"></i>
                Complete the Core Class Form
              <% end %><br/>
              <p class="mb-0">Email <%= mail_to "dcraig@yorku.ca" %> for more information.</p>
            </div>
        </div>
      </div>
    </section>

    <section class="row mx-0 mb-4 bg-light border border-2 rounded-1">
      <div class="col-12 p-0">
        <div class="p-3 border-start border-5 border-info">
            <h2 class="h3 mb-2">
              <i class="fas fa-search text-info me-2" aria-hidden="true"></i>
              Research Excellence Series
            </h2>
            <p class="col-xl-10 px-0 mb-2">The Research Excellence Series consists of library classes intended for more advanced courses. They are discipline- and subject-specific, 90 minutes each, interactive and participatory.</p>
            <p class="col-xl-10 px-0 mb-2 fw-bold">Please choose the broad area under which your course falls to find out more about learning outcomes, registration, scheduling, and more:</p>
            <nav class="col-xl-10 px-0 mt-3" aria-label="Research Excellence Series subject areas">
              <ul class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-2 list-unstyled mb-0">
                <li class="col">
                  <%= link_to "https://www.library.yorku.ca/web/ask-services/facultyinstructor-support/research-excellence-series-business/", 
                      class: "btn btn-light text-york-red-medium border-secondary d-block h-100 rounded-1 py-2 px-3 fw-bold", 
                      target: "_blank", rel: "noopener noreferrer" do %>
                    Business <i class="fas fa-external-link-alt ms-1" aria-hidden="true"></i><span class="visually-hidden"> (opens in a new tab)</span>
                  <% end %>
                </li>
                <li class="col">
                  <%= link_to "https://www.library.yorku.ca/web/ask-services/facultyinstructor-support/research-excellence-series-health-sciences/", 
                    class: "btn btn-light text-york-red-medium border-secondary d-block h-100 rounded-1 py-2 px-3 fw-bold", 
                    target: "_blank", rel: "noopener noreferrer" do %>
                    Health Sciences <i class="fas fa-external-link-alt ms-1" aria-hidden="true"></i><span class="visually-hidden"> (opens in a new tab)</span>
                  <% end %>
                </li>
                <li class="col">
                  <%= link_to "https://www.library.yorku.ca/web/ask-services/facultyinstructor-support/research-excellence-series-humanities/", 
                      class: "btn btn-light text-york-red-medium border-secondary d-block h-100 rounded-1 py-2 px-3 fw-bold", 
                      target: "_blank", rel: "noopener noreferrer" do %>
                    Humanities <i class="fas fa-external-link-alt ms-1" aria-hidden="true"></i><span class="visually-hidden"> (opens in a new tab)</span>
                  <% end %>
                </li>
                <li class="col">
                  <%= link_to "https://www.library.yorku.ca/web/ask-services/facultyinstructor-support/research-excellence-series-social-sciences-laps-euc-ed/", 
                      class: "btn btn-light text-york-red-medium border-secondary d-block h-100 rounded-1 py-2 px-3 fw-bold", 
                      target: "_blank", rel: "noopener noreferrer" do %>
                    Social Sciences <i class="fas fa-external-link-alt ms-1" aria-hidden="true"></i><span class="visually-hidden"> (opens in a new tab)</span>
                  <% end %>
                </li>
              </ul>
            </nav>
        </div>
      </div>
    </section>

    <section class="row mx-0 mb-4 bg-white border border-2 rounded-1">
      <div class="col-12 p-0">
        <div class="p-3 border-start border-5 border-success">
            <h2 class="h3 mb-2">
              <i class="fas fa-tools text-success me-2" aria-hidden="true"></i>
              Specialized classes
            </h2>
            <p class="col-xl-10 px-0 mb-2">Does your assignment or course require specialized instruction (for example, Government Documents, Data, Maps, or GIS)? If so, please use the booking link below.</p>
            <p class="col-xl-10 px-0 mb-3 text-secondary fw-bold"><i class="fas fa-clock text-success me-1" aria-hidden="true"></i> Three weeks is required for scheduling purposes.</p>
            <%= link_to new_user_teaching_request_path, class: "btn btn-success fw-bold text-wrap" do %>
              <i class="fas fa-calendar-plus me-1" aria-hidden="true"></i>
              Customized, Advanced or Graduate Class Request Form
            <% end %>
        </div>
      </div>
    </section>
  </div>

  <%# Previous two-column homepage layout retained temporarily for comparison. %>
  <div class="container-fluid mt-4">
    <div class="row d-flex align-items-stretch mt-4 border-1">
      <div class="col-md-6 col-sm-12 d-flex">
        <div class="d-flex flex-column p-3 bg-light border rounded w-100">
          <h3>Introduction to Library Research</h3>
          <p>If your students require introductory library skills to complete assignments in your course, we recommend our four-class series: <a href="https://www.library.yorku.ca/web/ask-services/facultyinstructor-support/think-research-create-introduction-to-library-research/">"Think, Research, Create: Introduction to Library Research"</a>, </p>
          <p>Each 90-minute class: </p>
          <ul>
            <li>Includes distinct knowledge and skills </li>
            <li>Employs active learning principles </li>
            <li>Is taught synchronously over Zoom or in person </li>
            <li>Is offered multiple times a term </li>
            
          </ul>
          
          <p>Students can receive a certificate of participation for each class they attend which they can upload to your e-class at your discretion. </p>
          <p>If you are interested in one or more of the classes and would like to ask your students to attend, please fill out the form below.</p>
          <p class="bg-warning text-dark small fw-2 badge text-center p-2" style="width: 100px">*** NEW *** </p>
          <div id="ilr-action">
            <%= link_to new_user_intro_library_research_path, class: 'btn btn-lg btn-dark w-100', 'aria-disabled': 'true' do %>
              <span><i class='fas fa-chalkboard-teacher mr-3'></i> &nbsp; Introduction to Library Research classes</span>
            <% end %>
          </div>
        
        </div>
      </div>
      <div class="col-md-6 col-sm-12 d-flex">
        <!-- <div class="p-3 bg-light border rounded mb-3"> -->
        <div class="d-flex flex-column p-3 bg-light border rounded w-100">
          <h3>Customized, Advanced or Graduate classes</h3>
          <p>Does your assignment or course require instruction beyond the fundamentals of library research? If so, please use the booking link below. Please note:  
          <ul> 
            <li>Three weeks is required for scheduling purposes </li>
            <li>The class should be scheduled a week or so after students have received their assignments / topics </li>
            <li>Instructors must be present throughout the class to engage with students and answer questions about the assignment / topics </li>
          </ul>
          <br/>
          <p class="text-success fw-2 small mt-auto">Available</p>
          <%= link_to new_user_teaching_request_path, class: 'btn btn-lg btn-success w-100' do %>
            <span><i class='fa fa-graduation-cap mr-2'></i>&nbsp; <%= t(:request_library_class, scope: :button) %></span>
          <% end %>
        </div>
      </div>
    </div>
    <div class="row mt-3">
      <div class="col-12 text-center">
        <p style="background-color: #eee" class="p-2"><%= raw t(:for_questions_and_suggestions, scope: :request_schedule_bullets) %>
        <%== Setting.questions_inquiries_contact %></p>
      </div>
    </div>

  </div>

</div> <!-- jumbo -->
