


<div class="row">
  <div class="col-sm-6">
    <h1>Intro_library_researches</h1>
  </div>

  <div class="col-sm-6 text-right">
  <%= link_to new_intro_library_research_path, class: 'btn btn-primary' do %>
    Add New Intro library research
  <% end %>
  </div>
</div>

<div class="table-responsive">
  <table class="table table-striped table-bordered table-hover">
    <thead>
      <tr>
    

            <th>Username</th>
            <th>Patron type</th>
            <th>First name</th>
            <th>Last name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Academic year</th>
            <th>Faculty</th>
            <th>Faculty abbrev</th>
            <th>Subject</th>
            <th>Subject abbrev</th>
            <th>Course number</th>
            <th>Course title</th>
            <th>Section name or about</th>
            <th>Status</th>
            <th>User</th>
            
          <th></th>
        
      </tr>
    </thead>

    <tbody>
      <% @intro_library_researches.each do |intro_library_research| %>
        <%= content_tag :tr, id: dom_id(intro_library_research), class: dom_class(intro_library_research) do %>
          

                      <td><%= intro_library_research.username %></td>
                      <td><%= intro_library_research.patron_type %></td>
                      <td><%= intro_library_research.first_name %></td>
                      <td><%= intro_library_research.last_name %></td>
                      <td><%= intro_library_research.email %></td>
                      <td><%= intro_library_research.phone %></td>
                      <td><%= intro_library_research.academic_year %></td>
                      <td><%= intro_library_research.faculty %></td>
                      <td><%= intro_library_research.faculty_abbrev %></td>
                      <td><%= intro_library_research.subject %></td>
                      <td><%= intro_library_research.subject_abbrev %></td>
                      <td><%= intro_library_research.course_number %></td>
                      <td><%= intro_library_research.course_title %></td>
                      <td><%= intro_library_research.section_name_or_about %></td>
                      <td><%= intro_library_research.status %></td>
                      <td><%= intro_library_research.user %></td>
          
          
            <td><%= link_to 'Show', intro_library_research %></td>
          
        <% end %>
      <% end %>
    </tbody>
  </table>
</div>
